# Copy this file to .env before running `docker compose up`.
# `.env` is read by Docker Compose, not directly by the Node app.

# Host port and interface used by Docker.
APP_PORT=3000
BIND_ADDR=127.0.0.1

# Use 0 when opening the app over plain local HTTP.
# Use 1 only when the app is behind HTTPS.
SECURE_COOKIES=0
